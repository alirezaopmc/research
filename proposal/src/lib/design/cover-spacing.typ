// Cover section spacing — tuned to match official form on one A4 page.
#let cover-spacing = (
  logo: (before: 0.6em, after: 0.8em),
  organization: (before: 0.5em, after: 0.8em),
  title: (before: 3.5em, after: 1.8em),
  options: (before: 1.2em, after: 2em, between-rows: 0.45em),
  form: (before: 1.5em, after: 1.8em),
  footer: (before: 0em, after: 0em),
)
