// Cover section spacing: before/after padding per visual block (edit here).
#let cover-spacing = (
  logo: (before: 1em, after: 1em),
  organization: (before: 1em, after: 1em),
  title: (before: 6em, after: 2em),
  options: (before: 2em, after: 3em, between-rows: 0.5em),
  form: (before: 4em, after: 4em),
  footer: (before: 0em, after: 0em),
)
