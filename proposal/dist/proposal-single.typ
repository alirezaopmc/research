  } else {
    labels.supervisor-role-advisor-secondary
  }
}


// ===== src/lib/components/shared/tech-footnote.typ =====
// Bilingual footnotes: Persian (RTL) and English (LTR).

#let en-footnote-body(content) = {
  set text(font: font-english, dir: ltr, lang: "en")
  content
}

#let fa-footnote-body(content) = {
  set text(dir: rtl, lang: "fa")
  content
}

#let fa-after(prefix, note) = [
  #prefix#footnote(numbering: footnote-fa-numbering, fa-footnote-body(note))
]

#let en-after(prefix, gloss) = [
  #prefix#footnote(numbering: footnote-fa-numbering, en-footnote-body(gloss))
]

// English gloss followed by a Persian note in one footnote.
// The gloss stays on the left; the note gets its own line aligned to the right.
// A full-width inline box keeps the note inside the entry paragraph.
#let en-fa-after(prefix, gloss, note) = [
  #prefix#footnote(numbering: footnote-fa-numbering)[
    #en-footnote-body(gloss)
    #linebreak()
    #box(width: 100%)[#align(right)[#fa-footnote-body(note)]]
  ]
]

#let en-only-footnote(gloss) = footnote(numbering: footnote-fa-numbering, en-footnote-body(gloss))

#let render-segments(segments) = {
  for seg in segments {
    let t = seg.at("text", default: "")
    let en = seg.at("en", default: none)
    let fa = seg.at("fa", default: none)
    let english-word = seg.at("ltr", default: false)
    if en != none and fa != none {
      en-fa-after(t, en, fa)
    } else if en != none {
      en-after(t, en)
    } else if fa != none {
      fa-after(t, fa)
    } else if english-word {
      en-only-footnote(t)
    } else {
      t
    }
  }
}

// Plain string or {segments: ...} rendered with footnotes, at body size.
#let rich-text(content) = {
  if type(content) == dictionary and content.at("segments", default: none) != none {
    text-base-body(render-segments(content.segments))
  } else {
    text-base-body(content)
  }
}

// Scope for English-only blocks (bibliography, etc.).
#let ltr-block(body) = {
  set text(dir: ltr, lang: "en", font: font-english)
  set align(left)
  set par(justify: false)
  body
}


// ===== src/lib/components/shared/data-table.typ =====
// Form tables: grid (timeline), registry (§2), fields (§3).

#let form-table-stroke-grid = 0.6pt + color-ut-blue
#let form-table-stroke-registry-edge = 0.35pt + color-ut-blue
#let form-table-stroke-registry-header = 1pt + color-ut-blue
#let form-table-stroke-registry-row = 0.35pt + color-ut-blue
#let form-table-stroke-signature = (
  thickness: 0.4pt,
  paint: color-ut-blue,
  dash: "dashed",
)

#let form-table-inset-grid = (x: 6pt, y: 8pt)
#let form-table-inset-registry = (x: 6pt, y: 10pt)
#let form-table-inset-fields = (x: 6pt, y: 10pt)

#let horizontal-stroke(total-rows, header-count, header-bottom) = (x, y) => {
  let top = if y == 0 { form-table-stroke-registry-edge } else { none }
  let bottom = if header-count > 0 and y == 0 {
    header-bottom
  } else {
    form-table-stroke-registry-row
  }
  (top: top, bottom: bottom, left: none, right: none)
}

#let registry-table-stroke(total-rows, header-count) = horizontal-stroke(
  total-rows,
  header-count,
  form-table-stroke-registry-header,
)

#let fields-table-stroke(total-rows) = horizontal-stroke(total-rows, 0, none)

#let registry-header-cell(label) = align(center + horizon)[
  #text(
    fill: color-ut-blue,
    hyphenate: false,
  )[#text-base-label(label.replace(" ", sym.space.nobreak))]
]

#let signature-placeholder-box(text-label: none) = align(center + horizon)[
  #box(width: 100%, height: 0.9cm, stroke: form-table-stroke-signature)[
    #if text-label != none {
      align(center + horizon)[#text(size: 8pt, fill: color-ut-blue)[#text-label]]
    }
  ]
]

#let signature-asset-root = "../assets/signatures/"

#let signature-cell-content(signature) = {
  if type(signature) == dictionary and signature.at("image", default: "").len() > 0 {
    align(center + horizon)[
      #image(
        signature-asset-root + signature.image,
        height: 0.85cm,
        fit: "contain",
      )
    ]
  } else if type(signature) == str and signature.len() == 0 {
    signature-placeholder-box()
  } else if type(signature) == str {
    align(center + horizon)[#text-base-body(signature)]
  } else {
    signature-placeholder-box()
  }
}

#let form-fields-sheet(rows) = {
  table(
    columns: (1fr, 1fr),
    rows: (auto,) * rows.len(),
    inset: form-table-inset-fields,
    stroke: fields-table-stroke(rows.len()),
    align: right + top,
    fill: (_, _) => white,
    ..rows.map(row => (row.at(0), row.at(1))).flatten(),
  )
}

#let form-data-table(
  columns,
  rows,
  header-cells: (),
  row-heights: none,
  align: right + top,
  style: "grid",
) = {
  if style == "fields" {
    form-fields-sheet(rows)
  } else {
    let header-count = if header-cells.len() > 0 { 1 } else { 0 }
    let total-rows = header-count + rows.len()
    let heights = if row-heights != none {
      row-heights
    } else {
      (auto,) * total-rows
    }
    let header-row = if header-count > 0 {
      (table.header(..header-cells, repeat: false),)
    } else {
      ()
    }
    let inset = if style == "registry" { form-table-inset-registry } else { form-table-inset-grid }
    let stroke = if style == "registry" {
      registry-table-stroke(total-rows, header-count)
    } else {
      form-table-stroke-grid
    }
    let table-align = if style == "grid" and align == right + top {
      center + horizon
    } else {
      align
    }

    table(
      columns: columns,
      rows: heights,
      inset: inset,
      stroke: stroke,
      align: table-align,
      fill: (_, _) => white,
      ..header-row,
      ..rows.flatten(),
    )
  }
}


// ===== src/lib/components/shared/figure.typ =====
// Shared figure primitives: Persian numbering, caption, nodes, arrows, band labels.

#let diagram-stroke = 0.75pt + color-ut-blue
#let diagram-stroke-emphasis = 1.5pt + color-ut-blue
#let diagram-stroke-rule = 0.5pt + color-ut-blue
#let diagram-arrow-size = 6pt
#let diagram-arrow-length = 0.7cm

// Diagram text is never justified: body text is justified by default.
#let body-figure(body, caption) = figure(
  align(center)[
    #set par(justify: false)
    #body
  ],
  caption: text-base-body(caption),
  supplement: [شکل],
  numbering: number => to-persian-digits(number),
  gap: space-sm,
)

// Body table with a numbered caption above it (جدول ۱).
#let body-table(body, caption) = figure(
  [
    #set par(justify: false)
    #body
  ],
  kind: table,
  caption: figure.caption(position: top, text-base-body(caption)),
  supplement: [جدول],
  numbering: number => to-persian-digits(number),
  gap: space-sm,
)

#let diagram-node(body, width: auto, emphasis: false) = box(
  width: width,
  inset: (x: 6pt, y: 6pt),
  stroke: if emphasis { diagram-stroke-emphasis } else { diagram-stroke },
  fill: white,
)[#align(center + horizon)[#body]]

// Arrow pointing left: the reading direction of the Persian (RTL) flow.
#let diagram-arrow-left(length: diagram-arrow-length) = box(
  width: length,
  height: diagram-arrow-size,
)[
  #place(horizon + left, line(length: 100%, stroke: diagram-stroke))
  #place(horizon + left, polygon(
    fill: color-ut-blue,
    stroke: none,
    (0pt, diagram-arrow-size / 2),
    (diagram-arrow-size, 0pt),
    (diagram-arrow-size, diagram-arrow-size),
  ))
]

// Arrow pointing up: rotated left arrow, used for vertical links.
#let diagram-arrow-up(length: diagram-arrow-length) = box(
