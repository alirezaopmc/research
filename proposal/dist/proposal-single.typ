  form-data-table(
    (1.4fr,) + (0.45fr,) * months.len(),
    phase-rows,
    header-cells:     (
      align(center + horizon)[#text-base-label("مرحله")],
      ..month-cells,
    ),
    style: "grid",
    align: center + horizon,
  )
}

