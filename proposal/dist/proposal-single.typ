}


// ===== src/lib/components/cover/organization.typ =====
// Cover affiliation block under the logo.

#let cover-organization(meta) = centered-stack(
  spacing: space-stack-relaxed,
  text-cover-organization(meta.faculty),
  text-cover-organization(meta.college),
  text-cover-organization(meta.university),
)


// ===== src/lib/components/cover/panel.typ =====
// Right-aligned form panel inside a centered width constraint.

#let cover-form-panel(body) = centered-block[
  #box(width: width-cover-form)[
    #set align(right)
    #body
  ]
]


// ===== src/lib/components/cover/spacing.typ =====
// Wraps a cover block with configurable before/after spacing from tokens.

#let cover-section(name, body) = {
  let pad = cover-spacing.at(name)
  [
    #v(pad.before)
    #body
    #v(pad.after)
  ]
}


// ===== src/lib/components/cover/title.typ =====
// Cover main title.

#let cover-title(labels) = text-cover-form-title(labels.title)


// ===== src/lib/components/cover/page.typ =====
// Cover page — official double-border layout (Behnam structure).

#let proposal-cover-page(locale) = {
  let labels = locale.labels
  let meta = locale.meta
  let selection = cover-selection(meta)
  let footnotes = labels.at("footnotes", default: ())

  cover-page-shell[
    #double-border-frame[
      #centered-stack(
        spacing: 0em,
        cover-section("logo", cover-header()),
        cover-section("organization", cover-organization(meta)),
        cover-section("title", cover-title(labels)),
        cover-section("options", cover-options-block(labels, selection)),
        cover-section("form", cover-form-panel(cover-form-fields(labels, meta))),
        cover-section("footer", cover-form-panel(cover-footer-fields(labels, meta))),
        if footnotes.len() > 0 {
          cover-footnotes(footnotes)
        },
      )
    ]
  ]
}


