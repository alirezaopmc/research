  "../content/fa/body/meta/figures.yaml": "definition-layers:\n  caption: \"دو سطح مطالعه‌ی رفتار مدل؛ ارزیابی رفتاری از روی ورودی و پاسخ، و تفسیر مکانیکی از روی ویژگی‌های میانی و مداخله‌ی علّی روی آن‌ها.\"\n  behavior-band: \"ارزیابی رفتاری: ورودی و پاسخ قابل مشاهده‌اند\"\n  mechanistic-band: \"تفسیر مکانیکی: مداخله بر ویژگی‌های میانی و سنجش اثر آن بر پاسخ\"\n  input: \"ورودی\"\n  input-detail: \"وظیفه، زمینه، صورت‌بندی\"\n  tokens: \"توکن‌ها\"\n  layers: \"لایه‌های ترانسفورمر\"\n  representation: \"ویژگی میانی\"\n  output: \"پاسخ\"\n\nnecessity-intervention:\n  caption: \"نمونه‌ای منتشرشده از مداخله‌ی علّی موضعی روی Claude 3.5 Haiku؛ شماتیک بر اساس [۹] بازترسیم شده و نتیجه‌ی این پژوهش نیست.\"\n  header-input: \"ورودی\"\n  header-representation: \"ویژگی میانی\"\n  header-output: \"پاسخ\"\n  prompt: \"پایتخت ایالتی که دالاس در آن قرار دارد\"\n  row-original: \"اجرای عادی\"\n  row-intervened: \"پس از جایگزینی\"\n  original-representation: \"تگزاس\"\n  original-output: \"آستین\"\n  intervened-representation: \"کالیفرنیا\"\n  intervened-output: \"ساکرامنتو\"\n\nmethodology-stages:\n  caption: \"شش مرحله‌ی پژوهش در سه گام و خروجی هر گام.\"\n  stages:\n    - title: \"گام ۱: مرور و آماده‌سازی\"\n      output: \"پرسش‌های پالایش‌شده، کاربرد منتخب، مدل، وظیفه و داده\"\n    - title: \"گام ۲: تحلیل بازنمایی و کاربرد\"\n      output: \"رابطه‌ی بازنمایی‌ها با رفتار و نتایج کاربرد منتخب\"\n      condition: \"مداخله مشروط به شواهد و امکان اجرا\"\n    - title: \"گام ۳: ارزیابی و جمع‌بندی\"\n      output: \"سودمندی، محدودیت‌ها و هزینه‌ی رویکرد و جهت‌های آینده\"\n\ncausal-steering:\n  caption: \"شماتیک مداخله‌ی علّی و هدایت روی ویژگی‌های میانی، الهام‌گرفته از نمونه‌ی [۸، ۹]؛ یال‌های ویژگی مهارشده حذف شده‌اند. احتمال‌ها فرضی‌اند، نمایش مفهومی است و نتیجه‌ی این پژوهش نیستند.\"\n  header-input: \"ورودی\"\n  header-hidden: \"ویژگی‌های میانی\"\n  header-output: \"پاسخ و احتمال\"\n  input-labels:\n    - \"پایتخت\"\n    - \"ایالت\"\n    - \"دالاس\"\n  capital-feature: \"ویژگی «پایتخت»\"\n  texas-feature: \"ویژگی «تگزاس»\"\n  inhibited: \"مهار شده\"\n  injected: \"بردار هدایت «کالیفرنیا»\"\n  # Outputs are ordered by score, highest first; the lower one is drawn transparent.\n  outputs-normal:\n    - name: \"آستین\"\n      score: \"۸۵٪\"\n    - name: \"ساکرامنتو\"\n      score: \"۵٪\"\n  outputs-steered:\n    - name: \"ساکرامنتو\"\n      score: \"۸۰٪\"\n    - name: \"آستین\"\n      score: \"۱۰٪\"\n  row-normal: \"اجرای عادی\"\n  row-steered: \"مداخله و هدایت\"\n",
  "../content/fa/body/meta/methodology.yaml": "intro:\n  segments:\n    - text: \"پژوهش در شش مرحله‌ی اکتشافی انجام می‌شود. نخست، مرور پیشینه و پالایش پرسش‌های پژوهش. دوم، آماده‌سازی آزمایش، شامل انتخاب مدل، وظیفه، داده و روش‌های تحلیل بازنمایی بر پایه‌ی پیشینه و منابع محاسباتی در دسترس. سوم، تحلیل بازنمایی‌های درونی و رابطه‌ی آن‌ها با رفتارهای منتخب. چهارم، بررسی یک یا چند کاربرد، مانند ارزیابی، پیش‌بینی، طبقه‌بندی یا مداخله، بسته به یافته‌های مقدماتی. پنجم، ارزیابی پایایی، سودمندی، محدودیت‌ها و هزینه‌ی محاسباتی رویکرد منتخب. ششم، تفسیر یافته‌ها، ثبت محدودیت‌ها و نگارش. دامنه‌ی پژوهش، رابطه‌ی بازنمایی‌های درونی و رفتار مشاهده‌پذیر در مدل‌های منتخب و تعداد محدودی وظیفه است. مرور پیشینه و آزمایش‌های مقدماتی یک کاربرد اصلی و حداکثر یک کاربرد فرعی را برای تمرکز پایان‌نامه تعیین می‌کنند. خطای واقعیتی در پرسش‌وپاسخ دانش‌محور، مطالعه‌ی موردی آغازین است.\"\nresources:\n  segments:\n    - text: \"آزمایش‌های اولیه روی \"\n    - text: \"گوگل کولب پرو\"\n      en: \"Google Colab Pro\"\n    - text: \" و \"\n    - text: \"واحد پردازش گرافیکی\"\n      en: \"graphics processing unit (GPU)\"\n    - text: \" در دسترس، مانند T4 با ۱۶ گیگابایت حافظه، و با مدل‌های وزن‌باز و منابع باز تحلیل بازنمایی انجام می‌شوند. برای نمونه، وزن‌های Gemma 2 2B با \"\n    - text: \"نیم‌دقت\"\n      en: \"half precision (fp16)\"\n    - text: \" حدود ۵ گیگابایت حافظه می‌گیرند و همراه با یک خودرمزنگار لایه‌ای Gemma Scope روی چنین پردازنده‌ای جا می‌شوند. فعال‌سازی‌ها یک‌بار استخراج و \"\n    - text: \"ذخیره‌سازی\"\n      en: \"activation caching\"\n    - text: \" می‌شوند تا تحلیل‌های بعدی بدون اجرای دوباره‌ی مدل انجام شوند. اندازه‌ی مدل، تعداد آزمایش‌ها و روش‌های تحلیل بر پایه‌ی منابع در دسترس انتخاب می‌شوند. گسترش‌های پرهزینه، مانند مدل‌های بزرگ‌تر یا آزمون اثر \"\n    - text: \"کوانتیزه‌سازی\"\n      en: \"quantization\"\n    - text: \"، به نتایج مقدماتی وابسته‌اند. آموزش مدل زبانی بزرگ جدید در دامنه‌ی این پژوهش نیست.\"\nnote:\n  segments:\n    - text: \"مدل، وظیفه، داده، سنجه‌ها و طرح مقایسه پس از مرور پیشینه و امکان‌سنجی اولیه انتخاب و پیش از آزمایش‌های اصلی در مخزن پژوهش ثبت می‌شوند. هر تغییر با ذکر دلیل ثبت و در پایان‌نامه گزارش می‌شود.\"\ntheory:\n  - segments:\n      - text: \"مرور منابع در پنج محور: رفتار مدل‌های زبانی بزرگ و قابلیت اطمینان آن‌ها [۳، ۴، ۵، ۱۹]، بازنمایی‌های درونی [۶، ۱۳، ۳۲]، روش‌های تحلیل بازنمایی مانند پروب و خودرمزنگار تنک [۱۰، ۱۲، ۱۷، ۲۴]، ارزیابی مبتنی بر خروجی و بازنمایی [۲۰، ۲۱، ۲۵، ۳۴]، و مداخله و هدایت [۱۴، ۱۵، ۳۱]. با توجه به منابع در دسترس، اولویت با پژوهش‌های قابل بازتولید روی مدل‌های وزن‌باز است.\"\n  - segments:\n      - text: \"پالایش پرسش‌های پژوهش و انتخاب کاربرد اصلی بر پایه‌ی مرور پیشینه و \"\n      - text: \"امکان‌سنجی\"\n      - text: \" اولیه، و بررسی اینکه آیا ترکیب، کاربرد یا اصلاح رویکردهای موجود می‌تواند بینش تازه‌ای درباره‌ی مسئله فراهم کند.\"\n  - segments:\n      - text: \"تدوین تعریف عملیاتی رفتارهای منتخب و معیار درستی آن‌ها. برای مطالعه‌ی موردی خطای واقعیتی، این تعریف می‌تواند بر مقایسه با پاسخ مرجع و الگوی تکرار پاسخ در نمونه‌های چندگانه‌ی یک پرسش استوار باشد [۶، ۳۴، ۴۱].\"\nimplementation:\n  - segments:\n      - text: \"راه‌اندازی خط لوله‌ای بازتولیدپذیر برای استخراج فعال‌سازی‌ها و تحلیل بازنمایی، و ثبت تنظیمات، داده‌ها و نتایج در یک محیط آزمایشی جداگانه. بسته به یافته‌ها و امکان اجرا، روش‌هایی مانند تحلیل حالت‌های پنهان، پروب خطی و دیگر پروب‌ها، تحلیل ویژگی و خودرمزنگارهای تنک بررسی می‌شوند. اجرای همه‌ی این روش‌ها الزامی نیست. اگر خودرمزنگار تنک به کار رود، بررسی‌های سلامت مانند خطای بازسازی ثبت می‌شوند [۱۷].\"\n  - segments:\n      - text: \"پیاده‌سازی کاربرد یا کاربردهای منتخب (⁦۴-۲-۳⁩) و مقایسه‌ی آن‌ها با رویکردهای موجود روی داده و تقسیم‌بندی یکسان؛ تحلیل خطاها و بررسی وابستگی به قالب یا موقعیت توکن، برای جلوگیری از تفسیر گمراه‌کننده.\"\n  - segments:\n      - text: \"اگر تحلیل مقدماتی بازنمایی‌هایی مرتبط با رفتارهای مشخص بیابد، بررسی می‌شود که آیا مداخله بر آن‌ها می‌تواند پاسخ مدل را تغییر دهد. در این آزمایش‌ها هم اثر مطلوب و هم پیامدهای ناخواسته، مانند افت دقت یا تعمیم‌پذیری، سنجیده می‌شوند. این بخش اکتشافی است و نتیجه‌ی منفی آن نیز گزارش می‌شود.\"\ndimensions:\n  - key: methodology-models\n    placeholder:\n      segments:\n        - text: \"یک یا چند مدل زبانی بزرگ وزن‌باز بر پایه‌ی این معیارها انتخاب می‌شود: دسترسی به وزن‌ها و فعال‌سازی‌های درونی، سازگاری با روش‌های تحلیل بازنمایی، نیاز محاسباتی، تناسب با وظیفه‌ی منتخب و وجود مستندات و منابع پشتیبان. Gemma 2 2B [۱۸]، به‌دلیل اندازه‌ی کوچک و وجود خودرمزنگارهای تنک باز Gemma Scope [۱۷]، نامزد اولیه است و انتخاب نهایی نیست.\"\n  - key: methodology-datasets\n    placeholder:\n      segments:\n        - text: \"وظایف و مجموعه‌داده‌ها بر پایه‌ی این معیارها انتخاب می‌شوند: ارتباط با پرسش‌های پژوهش، وجود معیار ارزیابی قابل‌اعتماد، تنوع پیامدهای رفتاری، سازگاری با مدل منتخب و امکان اجرا در زمان و منابع در دسترس. پرسش‌وپاسخ دانش‌محور وظیفه‌ی نامزد اولیه است و مجموعه‌داده‌هایی مانند TriviaQA [۲۶]، Natural Questions [۲۷، ۲۸]، PopQA [۲۹] و TruthfulQA [۱۹] گزینه‌های ممکن آن‌اند.\"\n  - key: methodology-behaviors\n    placeholder:\n      segments:\n        - text: \"سه کاربرد ممکن بررسی می‌شود: فهم رفتار، یعنی تحلیل الگوهای بازنمایی مرتبط با رفتار؛ ارزیابی رفتار، یعنی بررسی اینکه آیا بازنمایی‌ها به سنجش یا پیش‌بینی پاسخ کمک می‌کنند؛ و مداخله در رفتار، یعنی کاوش اینکه آیا تغییر بازنمایی‌ها پاسخ را تغییر می‌دهد. تشخیص خطای واقعیتی نمونه‌ای مشخص برای دو کاربرد نخست است: درستی پاسخ با پاسخ مرجع سنجیده می‌شود و می‌توان خطاها را بر پایه‌ی الگوی تکرار پاسخ در نمونه‌های چندگانه‌ی یک پرسش تفکیک کرد [۳۴، ۴۱]. تعریف عملیاتی رفتار هدف پس از انتخاب وظیفه ثبت می‌شود.\"\n  - key: methodology-metrics\n    placeholder:\n      segments:\n        - text: \"معیارهای ارزیابی پس از تعریف وظیفه و متناسب با آن انتخاب می‌شوند. محورهای ممکن عبارت‌اند از: کارایی پیش‌بینی یا طبقه‌بندی، در صورت کاربرد؛ پایایی و استحکام؛ تعمیم به وظایف یا شرایط دیگر، از جمله داده‌ی \"\n        - text: \"خارج از توزیع\"\n          en: \"out-of-distribution (OOD)\"\n        - text: \"؛ هزینه‌ی محاسباتی؛ و اثرها و پیامدهای جانبی مداخله، اگر مداخله بررسی شود. برای نمونه، در مطالعه‌ی موردی خطای واقعیتی، سنجه‌های تشخیص و کالیبراسیون مناسب‌اند. عدم‌قطعیت آماری نتایج با روش‌هایی مانند \"\n        - text: \"بوت‌استرپ\"\n          en: \"bootstrap resampling over questions\"\n        - text: \" روی پرسش‌ها گزارش می‌شود.\"\n  - key: methodology-baselines\n    placeholder:\n      segments:\n        - text: \"در صورت تناسب، تحلیل‌ها با رویکردهای موجود مقایسه می‌شوند: ارزیابی مبتنی بر خروجی، مانند احتمال توکنی، خودارزیابی [۲۰] و آنتروپی معنایی [۲۱، ۲۲]، و روش‌های مبتنی بر بازنمایی، مانند پروب خطی، میانگین تفاضلی [۱۳، ۱۵] و پروب آنتروپی معنایی [۲۵]. برای مداخله، خط‌مبناهای ساده مانند دستورالعمل و بردار خواندن [۱۴، ۱۵] در نظر گرفته می‌شوند. انتخاب روش‌های مقایسه به وظیفه‌ی نهایی و منابع محاسباتی بستگی دارد و هزینه‌ی محاسباتی هر روش در کنار نتایج گزارش می‌شود.\"\n  - key: methodology-analysis\n    placeholder:\n      segments:\n        - text: \"تقسیم‌بندی داده پیش از آزمایش‌های اصلی ثابت می‌شود و گزارش نهایی روی داده‌ای جدا از داده‌ی آموزش انجام می‌شود. در صورت امکان، آزمایش‌ها با چند \"\n        - text: \"بذر تصادفی\"\n          en: \"random seed\"\n        - text: \" تکرار می‌شوند و \"\n        - text: \"حذف مؤلفه\"\n          en: \"ablation\"\n        - text: \"، مثلاً روی لایه یا روش تحلیل، و آزمون انتقال میان منابع داده برای سنجش استحکام انجام می‌شوند.\"\n",
