  #body-heading(3, number, title)
  #v(0.45em)
  #for (index, entry) in entries.enumerate() [
    // Optional group label, set on the first entry of each group.
    #if entry.at("group", default: none) != none [
      #text-base-label[#text(fill: color-primary)[#entry.at("group")]]
      #v(0.2em)
    ]
    // Sticky term keeps each label with its definition across page breaks.
    #block(sticky: true)[
      #par[
        #text-base-label[
          #render-segments(((text: entry.at("term-fa")),))
          #if entry.at("term-en", default: none) != none [
            #if entry.at("term-en-footnote", default: true) [
              #render-segments(((text: "", en: entry.at("term-en")),))
            ]
          ]
        ]
      ]
    ]
    #par(rich-text(entry.at("definition")))
    #if index < entries.len() - 1 [#v(space-stack-tight)]
  ]
]


// ===== src/lib/components/body/topic.typ =====
// Section 4: topic with bilingual footnotes.

// Plain numbered list, matching the other body subsections (no form-style box).
#let research-questions-block(number, title, questions) = [
  #body-subheading(number, title)
  #set enum(
    numbering: index => to-persian-digits(index) + ")",
    indent: 0pt,
    body-indent: 0.6em,
    spacing: space-stack-relaxed,
  )
  #enum(..questions.map(question => rich-text(question)))
]

#let topic-block(number, title, content) = [
  #body-subheading(number, title)
  #if type(content) == dictionary {
    if content.at("segments", default: none) != none {
      par(rich-text(content))
    }
    if content.at("paragraphs", default: none) != none {
      for paragraph in content.paragraphs {
        if type(paragraph) == dictionary {
          if paragraph.at("segments", default: none) != none {
            par(rich-text(paragraph))
          } else {
            par(text-base-body(paragraph.at("text", default: "")))
          }
        } else {
          par(text-base-body(paragraph))
        }
      }
    }
    if content.at("text", default: none) != none {
      par(text-base-body(content.text))
    }
    if content.at("note", default: none) != none {
      v(space-xs)
      par(text-base-body(content.note))
    }
  } else if type(content) == str {
    for p in content.split("\n\n") {
      par(text-base-body(p))
    }
  } else {
    par(text-base-body(content))
  }
]

#let body-topic-section(labels, meta) = [
  #body-section-heading("۴", labels.section-topic)
  #body-subsection-heading("۴-۱", labels.section-topic-problem)
  #topic-block("۴-۱-۱", labels.topic-definition, meta.topic.definition)
  #definition-layers-figure(meta.figures.definition-layers)
  #key-concepts-panel("۴-۱-۲", labels.topic-key-concepts, meta.topic.key-concepts)
  #topic-block("۴-۱-۳", labels.topic-goal, meta.topic.goal)
  #topic-block("۴-۱-۴", labels.topic-necessity, meta.topic.necessity)
  #necessity-intervention-figure(meta.figures.necessity-intervention)
  #research-questions-block("۴-۱-۵", labels.topic-research-questions, meta.topic.research-questions)
]


// ===== src/lib/components/body/page.typ =====
// Body page orchestrator: stacks all form sections.

#let proposal-body-page(locale) = {
  let labels = locale.labels
  let meta = locale.meta
  let selection = body-selection(meta)

  letter-page-shell(
    [
      #body-summary-section(labels, meta, selection)
      #v(space-lg)
      #body-supervisors-table(labels, meta)
      #v(space-lg)
      #body-student-info(labels, meta)
      #body-topic-section(labels, meta)
      #body-methodology-section(labels, meta)
      #body-background-section(labels, meta)
      #body-timeline-section(labels, meta)
      #body-bibliography-section(labels, meta)
    ],
    labels.page-header-title,
  )
}


// ===== src/templates/proposal-body.typ =====
// Body adapter: maps locale dict to form section layout.

#let proposal-body-content(locale) = proposal-body-page(locale)


// ===== src/templates/proposal-document.typ =====
// Document composer: global setup, cover page, body form sections.
// No printed table of contents: the PDF outline (bookmarks) comes from the heading elements.

#let proposal-document(cover-locale, body-locale) = {
  setup-document[
    // Headings are styled by their own text roles; the heading block itself adds no spacing or weight.
    #show heading: it => it.body
    #proposal-cover(cover-locale)
    #pagebreak()
    #proposal-body-content(body-locale)
  ]
}


// ===== src/lib/content.typ =====
// Content layer: YAML loading and locale assembly.

#let merge-dicts(..dicts) = {
  let result = (:)
  for dict in dicts.pos() {
    for (key, value) in dict {
      result.insert(key, value)
    }
  }
  result
}

#let merge-dicts-strict(..dicts) = {
  let result = (:)
  for dict in dicts.pos() {
    for (key, value) in dict {
      assert(
        result.at(key, default: none) == none,
        message: "duplicate locale key: " + key,
      )
      result.insert(key, value)
    }
  }
  result
}

#let locale-base(locale) = "../content/" + locale

#let document-base(locale, document) = locale-base(locale) + "/" + document

#let join-path(base, ..parts) = {
  let path = base
  for part in parts.pos() {
    path += "/" + part
  }
  path + ".yaml"
}

#let load-yaml(base, ..parts) = yaml(join-path(base, ..parts))

#let load-cover-locale(locale: "fa", document: "cover") = {
  let base = locale-base(locale)
  let doc = document-base(locale, document)
  let labels = load-yaml(doc, "labels", "cover")
  let meta = merge-dicts-strict(
    load-yaml(base, "shared", "meta", "organization"),
    load-yaml(doc, "meta", "organization"),
    load-yaml(doc, "meta", "student"),
    load-yaml(doc, "meta", "form"),
  )
  (
    labels: labels,
    meta: meta,
  )
}

#let load-body-locale(locale: "fa", document: "body") = {
  let base = locale-base(locale)
  let doc = document-base(locale, document)
  let labels = merge-dicts(
    load-yaml(base, "shared", "labels", "common"),
    load-yaml(doc, "labels", "body"),
  )
  (
    labels: labels,
    meta: (
      summary: load-yaml(doc, "meta", "summary"),
      supervisors: load-yaml(doc, "meta", "supervisors"),
      student: load-yaml(doc, "meta", "student"),
      topic: load-yaml(doc, "meta", "topic"),
      figures: load-yaml(doc, "meta", "figures"),
      methodology: load-yaml(doc, "meta", "methodology"),
      background: load-yaml(doc, "meta", "background"),
      timeline: load-yaml(doc, "meta", "timeline"),
      bibliography: load-yaml(doc, "meta", "bibliography"),
    ),
  )
}

#let load-body-locale-signed(locale: "fa", document: "body") = {
  let body = load-body-locale(locale: locale, document: document)
  let doc = document-base(locale, document)
  let signed-supervisors = yaml(join-path(doc, "meta", "supervisors.signed"))
  (
    labels: body.labels,
    meta: (
      ..body.meta,
      supervisors: signed-supervisors,
    ),
  )
}


// ===== src/main/fa/proposal.typ =====
// Entry: loads YAML locales and renders full proposal PDF (cover + body).

#let cover-locale = load-cover-locale()
#let body-locale = load-body-locale()

#show: doc => proposal-document(cover-locale, body-locale)
